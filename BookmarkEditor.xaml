<Window x:Class="JASS.Bookmark.Master.BookmarkEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Bookmark" Width="650" Height="620" WindowStartupLocation="CenterOwner" Background="#F4F7FB"><ScrollViewer><StackPanel Margin="28"><TextBlock Text="Add to Master Library" FontSize="25" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Capture the bookmark once; organize it later with folders, tags and notes." Foreground="#60758A" Margin="0,4,0,18"/><TextBlock Text="Title"/><TextBox x:Name="TitleBox" Margin="0,4,0,12"/><TextBlock Text="URL"/><TextBox x:Name="Url" Margin="0,4,0,12"/><TextBlock Text="Folder"/><TextBox x:Name="Folder" Text="Unsorted" Margin="0,4,0,12"/><TextBlock Text="Tags"/><TextBox x:Name="Tags" Margin="0,4,0,12"/><TextBlock Text="Description"/><TextBox x:Name="Description" Height="65" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,12"/><TextBlock Text="Notes"/><TextBox x:Name="Notes" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,18"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save Bookmark" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Save_Click"/></StackPanel></StackPanel></ScrollViewer></Window>

<Window x:Class="JASS.Bookmark.Master.BookmarkEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Resource Editor" Width="700" Height="720" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
<ScrollViewer><StackPanel Margin="28"><TextBlock x:Name="Header" Text="Add Resource" FontSize="25" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Capture the resource once, then organize it with type, folders, tags, notes and collections." Foreground="#60758A" Margin="0,4,0,18" TextWrapping="Wrap"/>
<TextBlock Text="Title"/><TextBox x:Name="TitleBox" Margin="0,4,0,12"/><TextBlock Text="Resource Type"/><ComboBox x:Name="TypeBox" Margin="0,4,0,12"/><TextBlock Text="URL / Local Path"/><TextBox x:Name="Url" Margin="0,4,0,12"/><TextBlock Text="Folder (use / for hierarchy, e.g. AI/Models)"/><TextBox x:Name="Folder" Text="Unsorted" Margin="0,4,0,12"/><TextBlock Text="Tags (comma separated)"/><TextBox x:Name="Tags" Margin="0,4,0,12"/><TextBlock Text="Description"/><TextBox x:Name="Description" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,12"/><TextBlock Text="Personal Notes"/><TextBox x:Name="Notes" Height="110" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,18"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/><Button Content="Save Resource" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Save_Click"/></StackPanel></StackPanel></ScrollViewer></Window>

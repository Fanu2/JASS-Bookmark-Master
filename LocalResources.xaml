<UserControl x:Class="JASS.Bookmark.Master.LocalResources" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
<Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="White" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="12" Padding="18">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Local Resource Library" FontSize="22" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Search a folder recursively and add files or folders as local bookmarks in your master library." Foreground="#60758A" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
   <Button Grid.Column="1" Content="📁 Choose Folder" Click="ChooseFolder_Click" Background="#173B59" Foreground="White" BorderBrush="#173B59" Margin="10,0,4,0"/>
   <Button Grid.Column="2" Content="Scan" Click="Scan_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Margin="4,0,0,0"/>
  </Grid>
 </Border>
 <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBox x:Name="FolderBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center" ToolTip="Folder to search"/>
  <TextBox x:Name="LocalSearchBox" Grid.Column="1" Height="38" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="Search file name or path" TextChanged="LocalSearch_TextChanged"/>
  <CheckBox x:Name="IncludeFolders" Grid.Column="2" Content="Include folders" VerticalAlignment="Center" Margin="12,0"/>
  <Button Grid.Column="3" Content="＋ Add Selected" Click="AddSelected_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
 </Grid>
 <Border Grid.Row="2" Background="White" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="12,8"><TextBlock x:Name="ResultSummary" Text="Choose a folder to begin." Foreground="#60758A" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Add All Visible" Click="AddAll_Click"/></DockPanel>
   <DataGrid x:Name="LocalGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="LocalGrid_DoubleClick" RowHeight="38" Margin="8"><DataGrid.Columns>
    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="90"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/><DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*"/>
   </DataGrid.Columns></DataGrid>
  </Grid>
 </Border>
</Grid>
</UserControl>

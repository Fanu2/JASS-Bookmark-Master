<Application x:Class="JASS.Bookmark.Master.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Navy" Color="#102A43"/>
    <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Page" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="Muted" Color="#60758A"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17324D"/><Setter Property="BorderBrush" Value="#D5E0EA"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="#173B59"/><Setter Property="Foreground" Value="#F4F8FC"/>
      <Setter Property="BorderBrush" Value="#285271"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="6,4"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#C9D5E1"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/></Style>
  </Application.Resources>
</Application>

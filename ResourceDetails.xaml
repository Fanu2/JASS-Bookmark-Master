<Window x:Class="JASS.Bookmark.Master.ResourceDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Resource Details" Width="760" Height="650" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold" Foreground="#17324D"/><TextBlock x:Name="TypeText" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,4,0,18"/></StackPanel><ScrollViewer Grid.Row="1"><StackPanel><TextBlock Text="URL / PATH" FontWeight="SemiBold"/><TextBlock x:Name="UrlText" TextWrapping="Wrap" Margin="0,3,0,14"/><TextBlock Text="FOLDER" FontWeight="SemiBold"/><TextBlock x:Name="FolderText" Margin="0,3,0,14"/><TextBlock Text="TAGS" FontWeight="SemiBold"/><TextBlock x:Name="TagsText" TextWrapping="Wrap" Margin="0,3,0,14"/><TextBlock Text="DESCRIPTION" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,3,0,14"/><TextBlock Text="PERSONAL NOTES" FontWeight="SemiBold"/><TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,3,0,14"/><TextBlock x:Name="MetaText" Foreground="#60758A" TextWrapping="Wrap"/></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Close" Click="Close_Click" Margin="0,12,8,0"/><Button Content="Edit Resource" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Edit_Click" Margin="0,12,0,0"/></StackPanel></Grid>
</Window>

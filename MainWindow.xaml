<Window x:Class="JASS.Bookmark.Master.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JASS Bookmark Master v1.2 — Resource Library" Width="1440" Height="860" MinWidth="1100" MinHeight="650" Background="#F4F7FB" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#102A43"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="JASS" FontSize="32" FontWeight="Bold" Foreground="White" Margin="10,18,10,0"/><TextBlock Text="Bookmark Master" Foreground="#C9D8E8" FontSize="15" Margin="10,0,10,18"/><Border Background="#173B59" CornerRadius="10" Padding="12" Margin="4,0,4,15"><TextBlock Text="RESOURCE LIBRARY • PRIVATE • LOCAL" Foreground="#EAF3FB" FontWeight="SemiBold" FontSize="11"/>
</Border><Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click">⌂  Dashboard</Button><Button Style="{StaticResource NavButton}" Tag="All" Click="Nav_Click">▤  All Resources</Button><Button Style="{StaticResource NavButton}" Tag="Favorites" Click="Nav_Click">★  Favorites</Button><Button Style="{StaticResource NavButton}" Tag="ReadLater" Click="Nav_Click">◷  Read Later</Button><Separator Margin="5,12" Background="#31536E"/><TextBlock Text="RESOURCE LIBRARY" Foreground="#8FA8BF" FontSize="10" FontWeight="SemiBold" Margin="12,8,10,5"/><Button Style="{StaticResource NavButton}" Tag="Types" Click="Nav_Click">◈  Resource Types</Button><Button Style="{StaticResource NavButton}" Tag="Folders" Click="Nav_Click">▣  Folder Manager</Button><Button Style="{StaticResource NavButton}" Tag="Tags" Click="Nav_Click">#  Tag Manager</Button><Button Style="{StaticResource NavButton}" Tag="Collections" Click="Nav_Click">▦  Collections</Button><Separator Margin="5,12" Background="#31536E"/><Button Style="{StaticResource NavButton}" Tag="Duplicates" Click="Nav_Click">⧉  Duplicates</Button><Button Style="{StaticResource NavButton}" Tag="Broken" Click="Nav_Click">⚠  Broken Links</Button><Button Style="{StaticResource NavButton}" Tag="Local" Click="Nav_Click">▰  Local Resources</Button><Separator Margin="5,12" Background="#31536E"/><Button Style="{StaticResource NavButton}" Click="Import_Click">⇩  Import Bookmarks</Button><Button Style="{StaticResource NavButton}" Click="Export_Click">⇧  Export Master</Button><Button Style="{StaticResource NavButton}" Click="Backup_Click">◈  Backup / JSON</Button></StackPanel></ScrollViewer></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="#DCE5EE" BorderThickness="0,0,0,1"><Grid Margin="28,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Resource Library Dashboard" FontSize="26" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="One local, searchable master library for web resources and files." Foreground="#60758A" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" Height="40" VerticalAlignment="Center" ToolTip="Search title, URL, type, folder, tags, description or notes" TextChanged="Search_TextChanged"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="＋ Collection" Click="NewCollection_Click" Margin="8,0,4,0"/><Button Content="＋ Add Resource" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Add_Click"/></StackPanel></Grid></Border>
<Grid Grid.Row="1" Margin="28,18"><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions><Grid x:Name="LibraryWorkspace"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="10"><DataGrid x:Name="GridBookmarks" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick" RowHeight="42" Margin="6"><DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding ResourceType}" Width="130"/><DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="1.1*"/><DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.2*"/><DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="1.3*"/><DataGridTemplateColumn Header="★" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Favorite,Mode=OneWay}" Click="Favorite_Click" HorizontalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Later" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ReadLater,Mode=OneWay}" Click="ReadLater_Click" HorizontalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="⚠" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Broken,Mode=OneWay}" Click="Broken_Click" HorizontalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
<Border Grid.Column="1" Margin="14,0,0,0" Background="White" BorderBrush="#D8E2EC" BorderThickness="1" CornerRadius="10" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="RESOURCE DETAILS" FontSize="12" FontWeight="Bold" Foreground="#60758A"/><TextBlock x:Name="DetailTitle" Text="Select a resource" FontSize="22" FontWeight="Bold" Foreground="#17324D" Margin="0,8,0,3" TextWrapping="Wrap"/><TextBlock x:Name="DetailType" Foreground="#2563EB" FontWeight="SemiBold"/><TextBlock Text="URL / PATH" FontWeight="SemiBold" Margin="0,20,0,3"/><TextBlock x:Name="DetailUrl" TextWrapping="Wrap"/><TextBlock Text="FOLDER" FontWeight="SemiBold" Margin="0,14,0,3"/><TextBlock x:Name="DetailFolder" TextWrapping="Wrap"/><TextBlock Text="TAGS" FontWeight="SemiBold" Margin="0,14,0,3"/><TextBlock x:Name="DetailTags" TextWrapping="Wrap"/><TextBlock Text="DESCRIPTION" FontWeight="SemiBold" Margin="0,14,0,3"/><TextBlock x:Name="DetailDescription" TextWrapping="Wrap"/><TextBlock Text="PERSONAL NOTES" FontWeight="SemiBold" Margin="0,14,0,3"/><TextBlock x:Name="DetailNotes" TextWrapping="Wrap"/><TextBlock x:Name="DetailMeta" Foreground="#60758A" TextWrapping="Wrap" Margin="0,18,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Open" Click="OpenSelected_Click" Margin="0,0,6,0"/><Button Content="Edit" Click="EditSelected_Click" Margin="0,0,6,0"/><Button Content="Add to Collection" Click="AddToCollection_Click" Margin="0,0,6,0"/><Button Content="Delete" Click="DeleteSelected_Click"/></StackPanel></StackPanel></ScrollViewer></Border></Grid></Grid></Grid></Grid></Window>

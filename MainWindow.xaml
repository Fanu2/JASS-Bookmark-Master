<Window x:Class="JASS.Bookmark.Master.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JASS Bookmark Master" Width="1360" Height="820" MinWidth="1000" MinHeight="620" Background="#F4F7FB" WindowStartupLocation="CenterScreen">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Grid.Column="0" Background="#102A43"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
  <TextBlock Text="JASS" FontSize="32" FontWeight="Bold" Foreground="White" Margin="10,18,10,0"/><TextBlock Text="Bookmark Master" Foreground="#C9D8E8" FontSize="15" Margin="10,0,10,18"/>
  <Border Background="#173B59" CornerRadius="10" Padding="12" Margin="4,0,4,15"><TextBlock Text="PRIVATE • LOCAL • MASTER LIBRARY" Foreground="#EAF3FB" FontWeight="SemiBold" FontSize="11"/></Border>
  <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Nav_Click">⌂  Dashboard</Button>
  <Button Style="{StaticResource NavButton}" Tag="All" Click="Nav_Click">▤  All Bookmarks</Button>
  <Button Style="{StaticResource NavButton}" Tag="Favorites" Click="Nav_Click">★  Favorites</Button>
  <Button Style="{StaticResource NavButton}" Tag="ReadLater" Click="Nav_Click">◷  Read Later</Button>
  <Button Style="{StaticResource NavButton}" Tag="Folders" Click="Nav_Click">▣  Folders</Button>
  <Button Style="{StaticResource NavButton}" Tag="Tags" Click="Nav_Click">#  Tags</Button>
  <Button Style="{StaticResource NavButton}" Tag="Duplicates" Click="Nav_Click">⧉  Duplicates</Button>
  <Button Style="{StaticResource NavButton}" Tag="Broken" Click="Nav_Click">⚠  Broken Links</Button>
  <Button Style="{StaticResource NavButton}" Tag="Local" Click="Nav_Click">▰  Local Resources</Button>
  <Separator Margin="5,12" Background="#31536E"/>
  <Button Style="{StaticResource NavButton}" Click="Import_Click">⇩  Import Bookmarks</Button>
  <Button Style="{StaticResource NavButton}" Click="Export_Click">⇧  Export Master</Button>
  <Button Style="{StaticResource NavButton}" Click="Backup_Click">◈  Backup / JSON</Button>
  <TextBlock Text="LOCAL RESOURCES" Foreground="#8FA8BF" FontSize="10" FontWeight="SemiBold" Margin="12,18,10,5"/>
  <TextBlock Text="Scan folders on this PC and turn files or folders into bookmarkable links." Foreground="#BFD0DF" TextWrapping="Wrap" FontSize="11" Margin="12,0,10,12"/>
 </StackPanel></ScrollViewer></Border>
 <Grid Grid.Column="1" Margin="0">
  <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DCE5EE" BorderThickness="0,0,0,1"><Grid Margin="28,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Bookmark Dashboard" FontSize="26" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="One searchable, organized master library for bookmarks from every resource." Foreground="#60758A" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" Height="40" VerticalAlignment="Center" ToolTip="Search title, URL, folder, tags, notes" TextChanged="Search_TextChanged"/><Button Grid.Column="2" Content="＋ Add Bookmark" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Add_Click"/></Grid></Border>
  <Grid Grid.Row="1" Margin="28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ContentControl x:Name="MainContent"/><DataGrid x:Name="GridBookmarks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick" Margin="0,12,0,0" Background="White" BorderBrush="#D8E2EC" RowHeight="42" MinHeight="120"><DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="1.2*"/><DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.2*"/><DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="1.4*"/><DataGridTemplateColumn Header="★" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Favorite, Mode=OneWay}" Click="Favorite_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" ToolTip="Toggle favorite"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Later" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ReadLater, Mode=OneWay}" Click="ReadLater_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" ToolTip="Toggle read later"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="⚠" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Broken, Mode=OneWay}" Click="Broken_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" ToolTip="Toggle broken status"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
 </Grid>
</Grid>
</Window>

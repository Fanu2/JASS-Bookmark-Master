<Window x:Class="JASS.Bookmark.Master.CollectionEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="New Collection" Width="520" Height="330" WindowStartupLocation="CenterOwner" Background="#F4F7FB"><StackPanel Margin="28"><TextBlock Text="Create Research Collection" FontSize="24" FontWeight="Bold" Foreground="#17324D"/><TextBlock Text="Collections group resources without changing their folders." Foreground="#60758A" Margin="0,4,0,18" TextWrapping="Wrap"/><TextBlock Text="Name"/><TextBox x:Name="NameBox" Margin="0,4,0,14"/><TextBlock Text="Description"/><TextBox x:Name="DescriptionBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,18"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/><Button Content="Create Collection" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Save_Click"/></StackPanel></StackPanel></Window>
